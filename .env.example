# App
NEXT_PUBLIC_APP_URL=

# 운영자 문의 주소 - server only
# 거절 또는 정지된 계정 안내 화면에서만 사용한다. 비워두면 문의 링크를 표시하지 않는다.
SUPPORT_EMAIL=

# Supabase - browser-safe
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase - server only
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Google Drive OAuth - server only
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# Google Picker - browser-visible but restricted in Google Cloud
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=
NEXT_PUBLIC_GOOGLE_PICKER_APP_ID=

# Token encryption - server only
TOKEN_ENCRYPTION_KEY=

# External metadata APIs - server only
KAKAO_REST_API_KEY=
YOUTUBE_API_KEY=
TMDB_API_READ_TOKEN=
MUSICBRAINZ_USER_AGENT=

# Optional music providers
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Anthropic Claude - server only
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# 비워두면 위의 ANTHROPIC_MODEL을 쓴다. AI에게 물어보기에만 다른 모델을
# 쓰고 싶을 때 적는다. 올리려면 Anthropic 예산과 앱의 월 한도를 함께 본다.
ANTHROPIC_SEARCH_MODEL=
ANTHROPIC_BUDGET_USD=5