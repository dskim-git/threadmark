# App
NEXT_PUBLIC_APP_URL=

# 운영자 문의 주소 - server only
# 거절 또는 정지된 계정 안내 화면에서만 사용한다. 비워두면 문의 링크를 표시하지 않는다.
SUPPORT_EMAIL=

# Supabase - browser-safe
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase - server only
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Google Drive OAuth - server only
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# Google Picker - browser-visible but restricted in Google Cloud
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=
NEXT_PUBLIC_GOOGLE_PICKER_APP_ID=

# Token encryption - server only
TOKEN_ENCRYPTION_KEY=

# Kakao Maps JavaScript SDK - browser-visible, restricted by registered domain
NEXT_PUBLIC_KAKAO_JAVASCRIPT_KEY=

# External metadata APIs - server only
KAKAO_REST_API_KEY=
YOUTUBE_API_KEY=
TMDB_API_READ_TOKEN=
MUSICBRAINZ_USER_AGENT=

# Optional music providers
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Anthropic Claude - server only
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# 비워두면 위의 ANTHROPIC_MODEL을 쓴다. AI에게 물어보기에만 다른 모델을
# 쓰고 싶을 때 적는다. 올리려면 Anthropic 예산과 앱의 월 한도를 함께 본다.
ANTHROPIC_SEARCH_MODEL=
# 한 달 예산은 여기에 없다. app_settings의 ai_monthly_budget_usd에 있고
# 관리자 화면에서 바꾼다. (ADR 0003) 예전에 ANTHROPIC_BUDGET_USD가 여기
# 있었는데 코드가 읽는 곳이 없었다. 적어두면 고치고도 아무 일이 안 일어난다.